# Database Connection String for PostgreSQL (Neon Cloud / Supabase / Local)
DATABASE_URL="postgresql://neondb_owner:password@ep-wild-union-axed5dnp-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# NextAuth / Auth.js Configuration
AUTH_SECRET="your-32-char-random-auth-secret"
NEXTAUTH_SECRET="your-32-char-random-auth-secret"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth Credentials
AUTH_GOOGLE_ID="your-client-id.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="your-client-secret"

# Optional WebSocket Sync Server (leave empty on Vercel to use local-first IndexedDB mode)
# NEXT_PUBLIC_WS_URL="wss://your-ws-relay.fly.dev"

# Application Environment
NODE_ENV="development"
